.ruff_cache/
.mypy_cache/
build/
dist/
*.egg-info/
.env

# Local tool settings
.claude/settings.local.json

# Scratch space for reviews and experiments. Nothing in it is ever committed.
/tmp/

# David's snapshot of the workshop before the Remus engines, kept on his
# computer only
/.archive/

# Games David plays and analyzes, kept on his computer only
/docs/engines/played_games/

# git bundles that carry changes between computers
*.bundle

# Rust compiler output and local diagnostics are not source files.
/rust_engines/Remus*/target/
/rust_engines/Remus*/logs/
/rust_engines/Remus*/search_log.txt
/rust_engines/Remus*/ponder_log.txt

# Designer tools, private generated code, hooks, and workflows stay local.
/admin/
/engines_student/
/.githooks/
/.github/

# Local setup-state markers
/.workshop-student.json
