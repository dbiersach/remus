# Python and tooling
.venv/
.venv-ft/
__pycache__/
*.py[codz]
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/
*.egg-info/
.env

# Local tool settings
.claude/settings.local.json

# Scratch space for reviews and experiments. Nothing in it is ever committed.
/tmp/

# David's snapshot of the workshop before the Remus engines, kept on his
# computer only
/.archive/

# Games David plays and analyzes, kept on his computer only
/docs/engines/played_games/

# git bundles that carry changes between computers
*.bundle

# What cargo builds for Remus4-Rust. The finished remus4_rust.exe stays in git
/engines_instructor/Remus4-Rust/target/

# The workshop designer's tools, kept on David's computer only
/admin/

# David's commit hook and GitHub workflow, kept on his computer only
/.githooks/
/.github/

# Experimental Rust engine build directories; finished executables stay in git.
/engines_instructor/Remus5-Rust/target/
/engines_instructor/Remus6-Rust/target/
/engines_instructor/Remus7-Rust/target/
/engines_instructor/Remus7-Rust/ponder_log.txt

# Runtime diagnostics belong to each local engine installation.
/engines_instructor/*-Rust/search_log.txt
/engines_instructor/*-Rust/ponder_log.txt

# Python ponder diagnostics are local tournament evidence.
/engines_instructor/Remus5/ponder_logs/
