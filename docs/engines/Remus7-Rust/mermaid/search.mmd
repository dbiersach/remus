---
config:
  layout: elk
  theme: base
  htmlLabels: false
  themeVariables:
    fontFamily: Arial
    fontSize: 14px
    lineColor: '#64748b'
    primaryTextColor: '#172033'
  flowchart:
    htmlLabels: false
    curve: linear
    wrappingWidth: 320
    nodeSpacing: 24
    rankSpacing: 45
    padding: 10
---
flowchart TD
    UCI[main: UCI and root advice] --> Think[Search::think]
    Think --> Deepen[Worker::think: iterative deepening]
    Deepen --> AB[Worker::alpha_beta]
    AB --> First[Search first legal child]
    First --> AB
    AB --> Split[split_remaining: reserve idle helpers]
    Split --> Work[search_split: claim siblings]
    Work --> Move[search_split_move: one candidate]
    Move --> PVS[search_sibling: probe and verify]
    Split --> Drain[drain_split: close after all participants finish]
    Drain --> Help[help_descendant: save and restore task context]
    Help --> Claim[Pool::try_help: strict descendant and unique claim]
    Help --> Move
    Drain --> Wait[Result wait or cancellation wait]
    Wait --> Logs
    PVS --> AB
    AB --> Q[quiescence]
    AB --> Table[Shared atomic table]
    Deepen --> Control[SearchControl: commands and deadlines]
    Work --> Cancel[Split and ancestor cancellation]
    UCI --> Logs[SearchControl: persistent diagnostic logs]
    Think --> Logs
    Deepen --> Logs
    Control --> Logs
    UCI --> Resize[Search::set_hash: drain and recreate helpers]
    Resize --> Allocate[Table::with_size]
    AB --> Metrics[Worker-local TableMetrics]
    Work --> Merge[Pool::add_table_metrics after each job]
    Think --> Aggregate[Pool::table_metrics after work drains]
    Aggregate --> Logs
    AB --> Refresh[Table::refresh on useful cutoff]
    AB --> Research[Worker::research: verification node accounting]
    Research --> AB
    Think --> Timing[Per-worker active and wait time]
    Work --> Discard[Discarded and unclaimed sibling costs]
    Merge --> WorkerMetrics[Pool::add_worker_metrics]
    Timing --> Logs
    class AB module_search;
    class Aggregate module_parallel_search;
    class Allocate module_transposition_table;
    class Cancel module_parallel_search;
    class Claim module_parallel_search;
    class Control module_search_control;
    class Deepen module_search;
    class Discard module_search_metrics;
    class Drain module_search;
    class First module_search;
    class Help module_search;
    class Logs module_search_control;
    class Merge module_parallel_search;
    class Metrics module_table_metrics;
    class Move module_search;
    class PVS module_search;
    class Q module_search;
    class Refresh module_transposition_table;
    class Research module_search;
    class Resize module_search;
    class Split module_search;
    class Table module_transposition_table;
    class Think module_search;
    class Timing module_search_metrics;
    class UCI module_uci;
    class Wait module_search;
    class Work module_search;
    class WorkerMetrics module_parallel_search;
    classDef module_parallel_search fill:#c8def0,stroke:#475569,stroke-width:1px,color:#172033;
    classDef module_search fill:#fde2cf,stroke:#475569,stroke-width:1px,color:#172033;
    classDef module_search_control fill:#dce8d4,stroke:#475569,stroke-width:1px,color:#172033;
    classDef module_search_metrics fill:#d0e7ed,stroke:#475569,stroke-width:1px,color:#172033;
    classDef module_table_metrics fill:#ead8e5,stroke:#475569,stroke-width:1px,color:#172033;
