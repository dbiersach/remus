    AB --> AB
    AB --> Q[Search::quiescence - checks and terminal positions]
    AB --> TT[Table::probe and store]
    AB --> Prefetch[Table::prefetch]
    AB --> Eval[evaluate - pruning score when needed]
    Q --> Eval
    AB --> Order[ordered_moves and place_next]
    Think --> PV[Search::principal_variation]
    Think --> Control[SearchControl - completed iteration and time decisions]
    AB --> Poll[count_node - SearchControl::poll]
    UCI --> Advice[Tablebase - bounded root advice and native validation]
    UCI --> Book[legal_book_move - embedded lines and native validation]
