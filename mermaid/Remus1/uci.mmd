---
config:
  layout: elk
  theme: base
  htmlLabels: false
  themeVariables:
    fontFamily: Arial
    fontSize: 14px
    lineColor: '#64748b'
    primaryTextColor: '#172033'
  flowchart:
    htmlLabels: false
    curve: linear
    wrappingWidth: 320
    nodeSpacing: 24
    rankSpacing: 45
    padding: 10
---
flowchart TB
    n0["board.py<br/>parse_square()"]:::module_board
    n1["board.py<br/>square_name()"]:::module_board
    n2["make_move.py<br/>make_move()"]:::module_make_move
    n3["search.py<br/>think()"]:::module_search
    n4["uci.py<br/>module initialization"]:::module_uci
    n5["uci.py<br/>main()"]:::module_uci
    n6["uci.py<br/>read_time()"]:::module_uci
    n4 --> n5
    n5 --> n0
    n5 --> n1
    n5 --> n2
    n5 --> n3
    n5 --> n6
    classDef module_board fill:#e2e5f3,stroke:#475569,stroke-width:1px,color:#172033;
    classDef module_make_move fill:#ece4d6,stroke:#475569,stroke-width:1px,color:#172033;
    classDef module_search fill:#fde2cf,stroke:#475569,stroke-width:1px,color:#172033;
    classDef module_uci fill:#dbe8fb,stroke:#475569,stroke-width:1px,color:#172033;
