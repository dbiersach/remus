---
config:
  layout: elk
  theme: base
  htmlLabels: false
  themeVariables:
    fontFamily: Arial
    fontSize: 14px
    lineColor: '#64748b'
    primaryTextColor: '#172033'
  flowchart:
    htmlLabels: false
    curve: linear
    wrappingWidth: 320
    nodeSpacing: 24
    rankSpacing: 45
    padding: 10
---
flowchart TB
    n0["attacks.py<br/>in_check()"]:::module_attacks
    n1["make_move.py<br/>make_move()"]:::module_make_move
    n2["move_generation.py<br/>generate_moves()"]:::module_move_generation
    n3["search.py<br/>think()"]:::module_search
    n3 --> n0
    n3 --> n1
    n3 --> n2
    classDef module_attacks fill:#fadcec,stroke:#475569,stroke-width:1px,color:#172033;
    classDef module_make_move fill:#ece4d6,stroke:#475569,stroke-width:1px,color:#172033;
    classDef module_move_generation fill:#d4f1f1,stroke:#475569,stroke-width:1px,color:#172033;
    classDef module_search fill:#fde2cf,stroke:#475569,stroke-width:1px,color:#172033;
